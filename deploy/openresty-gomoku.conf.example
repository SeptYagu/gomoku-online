# Replace the example domain before installing this file.
# The Node service is intentionally bound to loopback, so it cannot be reached
# directly while GOMOKU_TRUST_PROXY=1 is enabled.
server {
    listen 80;
    server_name gomoku.example.com;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Overwrite any client-supplied XFF. Do not use
        # $proxy_add_x_forwarded_for here.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Keep this identical to the Socket.IO location.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
