# Replace the example domain before installing this file.
# The Node service is intentionally bound to loopback, so it cannot be reached
# directly while GOMOKU_TRUST_PROXY=1 is enabled.
server {
    listen 80;
    server_name gomoku.example.com;

    # Single-hop proxy: overwrite any client-supplied XFF with $remote_addr directly.
    # While $proxy_add_x_forwarded_for appends $remote_addr at the end (matching the
    # last-hop extraction in client-address.ts), overwriting eliminates client-supplied
    # header noise/formatting ambiguity and standardizes single/multi-hop contracts.
    #
    # Multi-hop proxy / CDN (e.g. Cloudflare -> Nginx -> Node):
    # Preferred: Use ngx_http_realip_module to restore client IP from trusted CIDRs:
    #   set_real_ip_from 103.21.244.0/22; # Cloudflare IP ranges
    #   real_ip_header CF-Connecting-IP;
    #   proxy_set_header X-Forwarded-For $remote_addr;
    # Alternative (ONLY if origin firewall strictly restricts ingress to CDN IPs):
    #   proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    # Note: Never use the alternative if origin allows direct public connections,
    # otherwise attackers can spoof CF-Connecting-IP to bypass rate limits.

    location /socket.io/ {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Keep this identical to the Socket.IO location.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
